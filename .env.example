# CivicShield AI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-to-a-very-strong-secret-key-in-production-min-32-chars

# Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///instance/database.db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://civic_user:civic_password@localhost:3306/civicshield

# Admin Account Bootstrap (Used by manage.py or initial setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@civicshield.local
ADMIN_PASSWORD=AdminSecurePass2026!
ADMIN_FULL_NAME=System Administrator

# Storage Paths
PROTECTED_UPLOAD_FOLDER=instance/protected_uploads

# Rate Limiting
RATELIMIT_DEFAULT=300 per day; 60 per hour
RATELIMIT_STORAGE_URI=memory://

# Optional Local AI (Ollama) Integration
# Leave default or configure if Ollama is running locally
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
